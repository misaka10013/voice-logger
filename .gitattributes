# 统一换行符：源码一律 LF 入库，避免 Windows/Linux 混用产生整文件 diff
* text=auto eol=lf

# Kotlin / Java / Gradle / Markdown
*.kt      text eol=lf
*.kts     text eol=lf
*.java    text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
*.pro     text eol=lf
*.properties text eol=lf

# 二进制：不做换行符转换，也不做 diff（否则仓库会膨胀）
*.png     binary
*.jpg     binary
*.webp    binary
*.aar     binary
*.jar     binary
*.onnx    binary
*.m4a     binary
*.wav     binary

# Gradle wrapper 脚本需要可执行位
gradlew        text eol=lf
gradlew.bat    text eol=crlf
