<?xml version="1.0" encoding="utf-8"?>
<!--
  voice-logger 清单

  权限说明：
  · RECORD_AUDIO                —— 采集麦克风（运行时权限，必须用户手动授予）
  · FOREGROUND_SERVICE          —— 常驻服务
  · FOREGROUND_SERVICE_MICROPHONE —— Android 14+ 必需，否则创建 microphone 类型 FGS 会抛异常
  · POST_NOTIFICATIONS          —— Android 13+ 通知栏常驻必须
  · WAKE_LOCK                   —— 息屏后保持 CPU 唤醒，避免采集线程被挂起
  · MODIFY_AUDIO_SETTINGS      —— 切换音频模式 / 通信设备（蓝牙麦克风要用）
  · INTERNET                    —— 把转写文字同步到云端，供外部 AI 读取
  · BLUETOOTH_CONNECT           —— **蓝牙麦克风必需**。Android 12+ 上不申报这个，
                                   「选择蓝牙麦」只是空选：系统会建立 SCO 路由，
                                   但应用拿不到数据，实际回落内置麦，而
                                   getRoutedDevice() 仍报蓝牙设备 —— 看起来成功，
                                   实际在骗人。2026-11-10 真机踩到过。
  · BLUETOOTH                   —— Android 11 及以下的对应旧权限

  ⚠️ 刻意不申请：
     · RECEIVE_BOOT_COMPLETED —— Android 14 起禁止从 BOOT_COMPLETED 启动 microphone 类型 FGS，
                                 申请了也没用，反而误导。本应用只能由用户手动点击开始。
     · SYSTEM_ALERT_WINDOW    —— 不需要悬浮窗
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 蓝牙麦克风：Android 12+ 必须 BLUETOOTH_CONNECT，否则选了也用不上（见上方说明）。
         它是「接近设备」类运行时权限，用户拒绝不影响手机麦录音，只是蓝牙麦不可用。 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="31" />
    <!-- Android 11 及以下的旧版蓝牙权限 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- 同步转写文字用。只走 HTTPS，不接受明文（见 SyncClient 的地址校验） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".VoiceLogApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceLog">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.VoiceLog">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          foregroundServiceType="microphone" 是硬性要求。
          Android 14+ 创建该类型服务时，系统会实时校验 RECORD_AUDIO 是否已授予，
          且必须在有可见 Activity 时启动 —— 因此只能由界面上的按钮拉起。
        -->
        <service
            android:name=".service.CaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 导出文字用的 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
