# ---------------------------------------------------------------- 构建产物
build/
.gradle/
.kotlin/
*.apk
*.aab
*.ap_
*.dex
captures/
release/

# ---------------------------------------------------------------- 本机配置
local.properties
*.iml
.idea/
.DS_Store

# ---------------------------------------------------------------- 调试产物
# 从手机拉下来的数据库副本、截图、测试音频。含真实录音文字，绝不入库。
.dbg/

# ---------------------------------------------------------------- 模型（2.2GB，绝不可入库）
# 模型通过 README 里的脚本下载，见「四、模型准备」
models/

# ---------------------------------------------------------------- 第三方预编译库（48MB）
# sherpa-onnx.aar 从官方 Release 下载，不入库。
# 缺失时 app/build.gradle.kts 会报错，按 README 补回即可。
app/libs/*.aar
app/libs/*.jar

# ---------------------------------------------------------------- 个人数据与调试残留
# 真机导出的数据库和录音，含真实对话内容，绝不入库
_backup/
*.db
*.db-wal
*.db-shm
*.m4a
*.wav
*.mp3

# 开发过程截图（17MB，且含个人信息画面）
_shot*.png
_v[0-9]*.png

# ---------------------------------------------------------------- 环境与密钥
# 若将来加签名配置，keystore 与密码一律不入库
*.jks
*.keystore
keystore.properties
.env
# CI 用来还原签名的临时目录
.keystore/

# 提交前扫描用的敏感词表：词表本身就是敏感信息，绝不入库
.privcheck-words

# 一次性声学实验（脚本可复现，产物不入库）
_exp/
*.m4a

# 基频回归测试用的真实录音样本 —— 是家里真实对话，绝不入库。
# 缺失时 PitchDetectorTest 会自动跳过真实录音那组用例（合成信号那组照跑）。
app/src/test/resources/f0/
